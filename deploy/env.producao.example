# Decreta no servidor: copie para /opt/decreta/.env, preencha e deixe com
# permissão 600 (só o appsvc lê). Nada daqui vai para o Git.
#
#   sudo install -m 600 -o appsvc -g appsvc deploy/env.producao.example /opt/decreta/.env

# --- API ---------------------------------------------------------------------
# Só na interface local: a internet entra pelo Caddy, na 443.
HOST=127.0.0.1
PORT=8791
# As telas compiladas, servidas pela própria API na mesma origem.
WEB_DIST=/opt/decreta/apps/web/dist

# --- Endereço ----------------------------------------------------------------
# O domínio do Decreta (registro A na Hostinger apontando para 201.23.84.78).
BETTER_AUTH_URL=https://decreta.site
WEB_ORIGIN=https://decreta.site
# openssl rand -hex 32
BETTER_AUTH_SECRET=

# --- Banco (deploy/postgres.sql) ---------------------------------------------
# A API entra como decreta_app (membro de app_user, sujeito a RLS).
DATABASE_URL=postgres://decreta_app:SENHA_APP@127.0.0.1:5432/decreta
# Migrations e backup entram como o dono do schema.
DATABASE_OWNER_URL=postgres://decreta_owner:SENHA_DONO@127.0.0.1:5432/decreta

# --- Inngest (o mesmo da máquina, 127.0.0.1:8288) ----------------------------
# O Decreta entra como mais um app no Inngest que já roda (plataforma-inngest).
# As duas chaves são as que esse Inngest usa (--event-key e --signing-key do serviço).
INNGEST_DEV=0
INNGEST_BASE_URL=http://127.0.0.1:8288
INNGEST_SERVE_ORIGIN=http://127.0.0.1:8791
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- IA: openrouter-gateway, projeto "decreta" (ZDR e teto diário lá) -------
LLM_BASE_URL=http://127.0.0.1:8799/v1
# Chave gw_ do projeto. Vazia: o Decreta funciona e as telas dizem que a IA está desligada.
LLM_API_KEY=
# Aliases configurados no gateway (o modelo de verdade por trás de cada um fica lá).
MODELO_JURIDICO=juridico
MODELO_AUTOS=autos
MODELO_DOCUMENTOS=documentos
MODELO_PDF=pdf
MODELO_VISION=vision
# Modo observar: alias candidato que lê as publicações em paralelo, sem efeito no
# escritório, para comparar com as decisões das pessoas (bun run observacao).
# Vazio: desligado, sem gasto. Até 30 leituras a mais por escritório por dia.
MODELO_OBSERVAR=
# Limites da IA nas telas (0 desliga cada um; o dia vira à meia-noite de Brasília).
# O teto do site fica abaixo do teto do projeto no gateway para sobrar para os
# prazos das publicações novas, que nunca são barrados pelo Decreta.
IA_MENSAGENS_POR_MINUTO=6
IA_MENSAGENS_POR_DIA=150
IA_TETO_PESSOA_USD=2
IA_TETO_SITE_USD=4
IA_DEMONSTRACAO_MENSAGENS_POR_DIA=30
IA_DEMONSTRACAO_TETO_USD=0.5
IA_PEDIDOS_SIMULTANEOS=2

# --- Captura -----------------------------------------------------------------
# DJEN não pede chave. DataJud: a chave pública que o CNJ publica na wiki da API
# (https://datajud-wiki.cnj.jus.br/api-publica/acesso). Vazia: os andamentos não atualizam.
DATAJUD_API_KEY=

# --- WhatsApp (wameow da máquina) --------------------------------------------
# O número do Decreta que manda o resumo da manhã. Vazio: o resumo não sai.
WAMEOW_URL=http://127.0.0.1:8080
WAMEOW_TOKEN=

# --- Demonstração (opcional: sudo deploy/decreta.sh demonstracao) -------------
# Senha da conta teste@decreta.site. A renovação de toda madrugada volta para ela.
DEMONSTRACAO_SENHA=

# --- Arquivos ----------------------------------------------------------------
# O disco da máquina está apertado (19 GB, 86% usado em 29/10/2026): os
# documentos vão para o Cloudflare R2. "disco" grava em ARQUIVOS_DIR.
ARQUIVOS=r2
ARQUIVOS_DIR=/opt/decreta/data/arquivos
ARQUIVO_MAX_MB=40
R2_ENDPOINT=https://ID_DA_CONTA.r2.cloudflarestorage.com
R2_BUCKET=decreta-arquivos
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Backup (decreta-backup.timer, todo dia às 03:30) -----------------------
# Bucket separado, com chave que só escreve nele.
BACKUP_R2_BUCKET=decreta-backups
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
# openssl rand -base64 32. Guarde uma cópia FORA do servidor: sem ela, nenhum backup abre.
BACKUP_KEY=
BACKUP_MAX_MB=800
# Banco vazio onde o backup de domingo é restaurado e conferido.
BACKUP_VERIFY_URL=postgres://decreta_owner:SENHA_DONO@127.0.0.1:5432/decreta_restauracao

# --- E-mail (convites e "esqueci a senha") -----------------------------------
# Vazio: o e-mail só vai para o log e a tela da Equipe mostra o link do convite para copiar.
RESEND_API_KEY=
EMAIL_FROM=Decreta <nao-responda@decreta.site>

# --- Erros -------------------------------------------------------------------
SENTRY_DSN=
