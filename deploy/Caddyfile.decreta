# Bloco do Decreta para o Caddy da máquina. `decreta.sh preparar` grava este
# arquivo em /etc/caddy/decreta.caddy, trocando DOMINIO pelo domínio do .env;
# o Caddyfile principal só ganha a linha `import /etc/caddy/decreta.caddy`.
DOMINIO {
	encode zstd gzip

	# As funções do Inngest só são chamadas de dentro da máquina.
	@inngest path /api/inngest /api/inngest/*
	respond @inngest 404

	request_body {
		max_size 45MB
	}

	# Quem carrega um segredo no endereço fica fora do log de acesso: o link de envio do cliente,
	# o token de trocar a senha e de confirmar o e-mail, e o id do convite (que vale como senha de entrar na equipe).
	@segredo path /api/envio/* /enviar/* /redefinir-senha /api/auth/reset-password /api/auth/reset-password/* /api/auth/verify-email /convite/* /api/convites/* /api/auth/organization/get-invitation
	log_skip @segredo

	# O aviso do Asaas leva o token no cabeçalho (asaas-access-token), que o log de acesso gravaria em claro: fora do log.
	@cobranca path /api/cobranca/*
	log_skip @cobranca

	reverse_proxy 127.0.0.1:8791 {
		# A peça e o chat chegam aos poucos: repassa cada pedaço na hora.
		flush_interval -1
		# Sem a Cloudflare na frente, este cabeçalho só viria forjado pelo cliente.
		header_up -Cf-Connecting-Ip
		transport http {
			read_timeout 180s
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), geolocation=(), microphone=(self)"
		-Server
	}

	# A demonstração pública: dados fictícios, a API de mentira no próprio navegador e nada saindo para a rede
	# (connect-src só data: e blob:, que a prévia usa para abrir os documentos embutidos). O app fica num iframe da mesma origem.
	@demonstracao path /demonstracao /demonstracao/*
	header @demonstracao {
		X-Frame-Options SAMEORIGIN
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src data: blob:; frame-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
	}

	@telas not path /demonstracao /demonstracao/*
	header @telas {
		X-Frame-Options DENY
		# 'wasm-unsafe-eval': o pdf.js decodifica as imagens dos PDFs escaneados (JBIG2, JPEG 2000) em WebAssembly.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' https://*.ingest.sentry.io https://*.ingest.us.sentry.io; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
	}

	log {
		output file /var/log/caddy/decreta.log {
			roll_size 10MiB
			roll_keep 3
		}
	}
}

# O www (CNAME para o domínio) só redireciona.
www.DOMINIO {
	redir https://DOMINIO{uri} permanent
}
