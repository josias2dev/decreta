# Desenvolvimento local. Copie para .env (o .env não vai para o Git).
# No servidor o modelo é deploy/env.producao.example.

# Postgres do docker-compose (porta 5433). A API entra como dc_app, sujeita a RLS;
# as migrations entram como o dono.
DATABASE_URL=postgres://dc_app:dc_app@localhost:5433/decreta
DATABASE_OWNER_URL=postgres://dc_owner:dc_owner@localhost:5433/decreta
# Para `bun test`: um usuário com CREATEDB e CREATEROLE (cada teste cria o próprio banco).
TEST_OWNER_URL=postgres://dc_owner:dc_owner@localhost:5433/postgres

# openssl rand -hex 32
BETTER_AUTH_SECRET=troque-por-32-caracteres-ou-mais-aleatorios
BETTER_AUTH_URL=http://localhost:8787
# As telas no Vite (bun run web) ficam em 5173 e fazem proxy de /api para a 8787.
WEB_ORIGIN=http://localhost:5173

# Inngest de desenvolvimento do docker-compose (painel em http://localhost:8288).
INNGEST_DEV=1

# IA pelo openrouter-gateway. Sem a chave, o Decreta funciona e as telas dizem
# que a IA está desligada (e dá para escrever as peças à mão).
LLM_BASE_URL=http://127.0.0.1:8799/v1
LLM_API_KEY=

# DataJud: a chave pública que o CNJ publica na wiki da API
# (https://datajud-wiki.cnj.jus.br/api-publica/acesso). Vazia: os andamentos não atualizam.
DATAJUD_API_KEY=

# Arquivos numa pasta local.
ARQUIVOS=disco
ARQUIVOS_DIR=./data/arquivos
